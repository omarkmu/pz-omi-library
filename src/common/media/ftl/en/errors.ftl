### Error messages shared across mods
### @bundle @error

# @param $max integer The maximum length.
length-max = Length must be less than or equal to { $max }.

# @param $min integer The minimum length.
length-min = Length must be greater than or equal to { $min }.

require-color = Input must be a hexadecimal color value or three numbers separated by commas or spaces.

require-number = Input must be numeric.

require-integer = Input must be an integer.

require-value = Input cannot be empty.

# @param $max number The maximum value.
value-max = Value must be less than or equal to { $max }.

# @param $min number The minimum value.
value-min = Value must be greater than or equal to { $min }.

# @param $max number The maximum value.
values-max = Values must be less than or equal to { $max }.

# @param $min number The minimum value.
values-min = Values must be greater than or equal to { $min }.

# @param $max number The maximum number of items.
max-items-reached = Maximum number of items already reached ({ $max }).
